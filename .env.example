# AIDP / Starburst Enterprise endpoint (HTTPS only)
AIDP_ENDPOINT=https://ddae.lab9bgp.com

# AIDP administrator used for all setup/configuration (holds SEP sysadmin)
AIDP_ADMIN_USER=dv-admin
AIDP_ADMIN_PASSWORD=replace_me

# Shared password for the gov-* demo users (Keycloak enforces min length 9)
AIDP_DEMO_USER_PASSWORD=replace_me

# TLS verification: path to CA bundle, or set AIDP_VERIFY_TLS=false for lab only
AIDP_CA_BUNDLE=/home/kiran/jirawut-demo/.certs/devin-ca-bundle.pem
AIDP_VERIFY_TLS=true

# Keycloak (AIDP identity provider) - used only for identity verification/mapping
KEYCLOAK_URL=https://ddlh.lab9bgp.com/auth
KEYCLOAK_REALM=ddae

# OpenMetadata
OM_BASE=http://10.246.25.115:8585
OM_SERVICE=js_aidp_starburst
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=replace_me

# Identity that owns SECURITY DEFINER curated views (its default-enabled
# roles must be able to read gov_demo). jirawut is the data-engineering user.
AIDP_VIEW_OWNER_USER=jirawut
AIDP_VIEW_OWNER_PASSWORD=replace_me
